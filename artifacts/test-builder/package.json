{
  "name": "@workspace/test-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ai-build": "playwright test --config playwright.config.ts e2e/ai-agent-build-with-ai.spec.ts",
    "test:e2e:delete-approval": "playwright test --config playwright.config.ts e2e/project-delete-approval.spec.ts",
    "test:e2e:clear-files-approval": "playwright test --config playwright.config.ts e2e/project-clear-files-approval.spec.ts",
    "test:e2e:fork-and-branches": "playwright test --config playwright.config.ts e2e/fork-and-branches.spec.ts",
    "test:e2e:repo-pats": "playwright test --config playwright.config.ts e2e/repo-pats-admin.spec.ts",
    "test:e2e:clone-project": "playwright test --config playwright.config.ts e2e/clone-from-repo.spec.ts",
    "test:e2e:lifecycle-combined": "playwright test --config playwright.config.ts e2e/project-lifecycle-combined.spec.ts",
    "lint:layers": "depcruise --config .dependency-cruiser.cjs src/features",
    "docs:matrix": "tsx ./scripts/gen-role-page-matrix.ts",
    "docs:screenshots": "playwright test --config playwright.docs.config.ts",
    "test:e2e:ai-providers": "playwright test --config playwright.config.ts e2e/ai-agent-providers.spec.ts",
    "test:e2e:ai-assists": "playwright test --config playwright.config.ts e2e/ai-agent-assists.spec.ts",
    "test:e2e:ai-existing-suite": "playwright test --config playwright.config.ts e2e/ai-agent-existing-suite.spec.ts",
    "test:e2e:open-browser-recording": "playwright test --config playwright.config.ts e2e/open-browser-recording.spec.ts",
    "test:e2e:keep-browser-open": "playwright test --config playwright.config.ts e2e/keep-browser-open.spec.ts",
    "test:e2e:jmx-no-auto-record": "playwright test --config playwright.config.ts e2e/jmx-no-auto-record.spec.ts",
    "test:e2e:jmx-bff-recording": "playwright test --config playwright.config.ts e2e/jmx-bff-recording.spec.ts",
    "test:e2e:team-invite-local": "playwright test --config playwright.config.ts e2e/team-invite-local.spec.ts",
    "test:e2e:fix-selector": "playwright test --config playwright.config.ts e2e/fix-selector-ai.spec.ts",
    "test:e2e:all": "pnpm run test:e2e:ai-build && pnpm run test:e2e:ai-providers && pnpm run test:e2e:ai-assists && pnpm run test:e2e:ai-existing-suite && pnpm run test:e2e:clear-files-approval && pnpm run test:e2e:clone-project && pnpm run test:e2e:delete-approval && pnpm run test:e2e:fix-selector && pnpm run test:e2e:fork-and-branches && pnpm run test:e2e:jmx-bff-recording && pnpm run test:e2e:jmx-no-auto-record && pnpm run test:e2e:keep-browser-open && pnpm run test:e2e:lifecycle-combined && pnpm run test:e2e:open-browser-recording && pnpm run test:e2e:repo-pats && pnpm run test:e2e:team-invite-local"
  },
