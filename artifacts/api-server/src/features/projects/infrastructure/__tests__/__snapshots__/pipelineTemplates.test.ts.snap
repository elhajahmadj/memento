exports[`buildPipelineFile snapshot matrix > 'circleci' / 'csharp' / 'cd' renders deterministically 1`] = `
"version: 2.1

jobs:
  build:
    docker:
      - image: mcr.microsoft.com/dotnet/sdk:8.0
    steps:
      - checkout
      - run:
          name: Install build dependencies
          command: |
            dotnet restore
      - run:
          name: Build drop
          command: |
            dotnet build -c Release
            mkdir -p drop
            rsync -a --exclude drop --exclude .git ./ drop/
      - persist_to_workspace:
          root: .
          paths:
            - drop

  test:
    docker:
      - image: mcr.microsoft.com/dotnet/sdk:8.0
    working_directory: ~/project/drop
    steps:
      - attach_workspace:
          at: ~/project
      - run:
          name: Install test dependencies
          command: |
            dotnet restore
      - run:
          name: Run Playwright tests
          command: |
            dotnet test --logger trx --results-directory TestResults
      - store_artifacts:
          path: drop/TestResults
          destination: TestResults
      - store_artifacts:
          path: drop/playwright-report
          destination: playwright-report

workflows:
  build_and_test:
    jobs:
      - build
      - test:
          requires:
            - build
"
`;

