"# Azure Pipelines (build + deploy/test) for Playwright tests
trigger:
  branches:
    include:
      - main
pr:
  branches:
    include:
      - main

stages:
  - stage: Build
    jobs:
      - job: build
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: self

      - task: JavaToolInstaller@0
        inputs:
          versionSpec: "21"
          jdkArchitectureOption: x64
          jdkSourceOption: PreInstalled

      - task: Cache@2
        displayName: Cache Maven repository
        inputs:
          key: 'maven | "$(Agent.OS)" | **/pom.xml'
          restoreKeys: |
            maven | "$(Agent.OS)"
            maven
          path: $(HOME)/.m2/repository

      - script: |
          mvn -B -DskipTests package
          mkdir -p drop
          rsync -a --exclude drop --exclude .git ./ drop/
        displayName: Build drop

          - task: PublishPipelineArtifact@1
            displayName: Publish drop
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/drop
              artifactName: drop

  - stage: DeployAndTest
    dependsOn: Build
    jobs:
      - job: test
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: none

      - task: JavaToolInstaller@0
        inputs:
          versionSpec: "21"
          jdkArchitectureOption: x64
          jdkSourceOption: PreInstalled

      - task: Cache@2
        displayName: Cache Maven repository
        inputs:
          key: 'maven | "$(Agent.OS)" | **/pom.xml'
          restoreKeys: |
            maven | "$(Agent.OS)"
            maven
          path: $(HOME)/.m2/repository

          - task: DownloadPipelineArtifact@2
            displayName: Download drop
            inputs:
              artifact: drop
              path: $(System.DefaultWorkingDirectory)/drop

          - script: |
          : # no install step
            displayName: Install test dependencies
            workingDirectory: $(System.DefaultWorkingDirectory)/drop

          - script: |
          mvn -B test
            displayName: Run Playwright tests
            workingDirectory: $(System.DefaultWorkingDirectory)/drop

          - task: PublishPipelineArtifact@1
            displayName: Publish test reports
            condition: always()
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/drop
              artifactName: playwright-reports
"
`;

