exports[`buildPipelineFile snapshot matrix > 'gitlab' / 'csharp' / 'cd' renders deterministically 1`] = `
"# GitLab CI/CD pipeline (build + deploy/test) for Playwright tests
image: mcr.microsoft.com/dotnet/sdk:8.0

stages:
  - build
  - test

build:
  stage: build
  rules:
    - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "main"
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  script:
    - dotnet restore
    - dotnet build -c Release
    - mkdir -p drop
    - rsync -a --exclude drop --exclude .git ./ drop/
  artifacts:
    name: drop
    expire_in: 1 week
    paths:
      - drop/

test:
  stage: test
  rules:
    - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "main"
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  dependencies:
    - build
  before_script:
    - cd drop
  script:
    - dotnet restore
    - dotnet test --logger trx --results-directory TestResults
  artifacts:
    when: always
    expire_in: 1 week
    paths:
      - drop/TestResults/
      - drop/playwright-report/
"
`;

