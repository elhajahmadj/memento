exports[`buildPipelineFile snapshot matrix > 'github' / 'python' / 'cd' renders deterministically 1`] = `
"name: Playwright Tests (CD)
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    name: Build and publish drop
    runs-on: ubuntu-latest
    steps:
      - name: Check out source
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Build drop
        run: |
          mkdir -p drop
          rsync -a --exclude drop --exclude .git --exclude __pycache__ --exclude .pytest_cache ./ drop/

      - name: Upload drop artifact
        uses: actions/upload-artifact@v4
        with:
          name: drop
          path: drop/
          if-no-files-found: error

  test:
    name: Run Playwright tests against drop
    needs: build
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: drop
    steps:
      - name: Download drop artifact
        uses: actions/download-artifact@v4
        with:
          name: drop
          path: drop/

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install test dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          playwright install --with-deps

      - name: Run Playwright tests
        run: |
          pytest

      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-reports
          path: |
            drop/playwright-report/
          if-no-files-found: ignore
"
`;

