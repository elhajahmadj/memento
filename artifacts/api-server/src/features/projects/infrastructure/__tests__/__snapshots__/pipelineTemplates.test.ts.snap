exports[`buildPipelineFile snapshot matrix > 'jenkins' / 'csharp' / 'cd' renders deterministically 1`] = `
"pipeline {
  agent any

  options {
    timestamps()
  }

  // Configure your agent to provide the matching toolchain (.NET 8 SDK).
  stages {
    stage('Build') {
      steps {
        checkout scm
          sh 'dotnet restore'
        sh 'dotnet build -c Release'
        sh 'mkdir -p drop'
        sh 'rsync -a --exclude drop --exclude .git ./ drop/'
        stash name: 'drop', includes: 'drop/**/*'
      }
    }

    stage('Deploy and test') {
      steps {
        deleteDir()
        unstash 'drop'
        dir('drop') {
            sh 'dotnet restore'
            sh 'dotnet test --logger trx --results-directory TestResults'
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'drop/TestResults/**/*', 'drop/playwright-report/**/*', allowEmptyArchive: true, fingerprint: true
    }
  }
}
"
`;

