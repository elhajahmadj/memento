exports[`buildPipelineFile snapshot matrix > 'azure' / 'csharp' / 'cd' renders deterministically 1`] = `
"# Azure Pipelines (build + deploy/test) for Playwright tests
trigger:
  branches:
    include:
      - main
pr:
  branches:
    include:
      - main

stages:
  - stage: Build
    jobs:
      - job: build
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: self

      - task: UseDotNet@2
        inputs:
          packageType: sdk
          version: "8.0.x"

      - script: |
          dotnet build -c Release
          mkdir -p drop
          rsync -a --exclude drop --exclude .git ./ drop/
        displayName: Build drop

          - task: PublishPipelineArtifact@1
            displayName: Publish drop
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/drop
              artifactName: drop

  - stage: DeployAndTest
    dependsOn: Build
    jobs:
      - job: test
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: none

      - task: UseDotNet@2
        inputs:
          packageType: sdk
          version: "8.0.x"

          - task: DownloadPipelineArtifact@2
            displayName: Download drop
            inputs:
              artifact: drop
              path: $(System.DefaultWorkingDirectory)/drop

          - script: |
          dotnet restore
            displayName: Install test dependencies
            workingDirectory: $(System.DefaultWorkingDirectory)/drop

          - script: |
          dotnet test --logger trx --results-directory TestResults
            displayName: Run Playwright tests
            workingDirectory: $(System.DefaultWorkingDirectory)/drop

          - task: PublishPipelineArtifact@1
            displayName: Publish test reports
            condition: always()
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/drop
              artifactName: playwright-reports
"
`;

