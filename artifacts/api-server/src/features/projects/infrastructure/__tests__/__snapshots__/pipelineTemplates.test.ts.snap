exports[`buildPipelineFile snapshot matrix > 'azure' / 'python' / 'cd' renders deterministically 1`] = `
"# Azure Pipelines (build + deploy/test) for Playwright tests
trigger:
  branches:
    include:
      - main
pr:
  branches:
    include:
      - main

stages:
  - stage: Build
    jobs:
      - job: build
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: self

      - task: UsePythonVersion@0
        inputs:
          versionSpec: "3.12"

      - script: |
          mkdir -p drop
          rsync -a --exclude drop --exclude .git --exclude __pycache__ --exclude .pytest_cache ./ drop/
        displayName: Build drop

          - task: PublishPipelineArtifact@1
            displayName: Publish drop
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/drop
              artifactName: drop

  - stage: DeployAndTest
    dependsOn: Build
    jobs:
      - job: test
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: none

      - task: UsePythonVersion@0
        inputs:
          versionSpec: "3.12"

          - task: DownloadPipelineArtifact@2
            displayName: Download drop
            inputs:
              artifact: drop
              path: $(System.DefaultWorkingDirectory)/drop

          - script: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          playwright install --with-deps
            displayName: Install test dependencies
            workingDirectory: $(System.DefaultWorkingDirectory)/drop

          - script: |
          pytest
            displayName: Run Playwright tests
            workingDirectory: $(System.DefaultWorkingDirectory)/drop

          - task: PublishPipelineArtifact@1
            displayName: Publish test reports
            condition: always()
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/drop
              artifactName: playwright-reports
"
`;

