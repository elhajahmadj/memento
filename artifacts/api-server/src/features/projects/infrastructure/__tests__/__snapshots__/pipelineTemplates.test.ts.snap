exports[`buildPipelineFile snapshot matrix > 'github' / 'csharp' / 'cd' renders deterministically 1`] = `
"name: Playwright Tests (CD)
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    name: Build and publish drop
    runs-on: ubuntu-latest
    steps:
      - name: Check out source
        uses: actions/checkout@v4

      - name: Set up .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "8.0.x"

      - name: Build drop
        run: |
          dotnet build -c Release
          mkdir -p drop
          rsync -a --exclude drop --exclude .git ./ drop/

      - name: Upload drop artifact
        uses: actions/upload-artifact@v4
        with:
          name: drop
          path: drop/
          if-no-files-found: error

  test:
    name: Run Playwright tests against drop
    needs: build
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: drop
    steps:
      - name: Download drop artifact
        uses: actions/download-artifact@v4
        with:
          name: drop
          path: drop/

      - name: Set up .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "8.0.x"

      - name: Install test dependencies
        run: |
          dotnet restore

      - name: Run Playwright tests
        run: |
          dotnet test --logger trx --results-directory TestResults

      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-reports
          path: |
            drop/TestResults/
            drop/playwright-report/
          if-no-files-found: ignore
"
`;

