# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# runtime workspace data (forks, approval snapshots).
# Ignore every child of workspace/ ... except the canonical seeded
# `AiAgentTesting` C# Playwright project, which ships with the repo so
# the AI Agent e2e specs have a deterministic fixture to load
# (task #43). We can't ignore `workspace/` as a whole because git can
# never re-include children of an ignored directory.
workspace/*
!workspace/AiAgentTesting/
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# .NET build artifacts (generated by dotnet build / restore)
**/bin/
**/obj/
artifacts/api-server/.validation-traces/

# ---- graphify knowledge graph (regenerates for free via `graphify update .`) ----
# graphify-out/ is a build artifact: large, machine-specific, and rebuilt from the AST with no
# API cost. The skill (.claude/skills/graphify/) and CLAUDE.md guidance ARE committed so everyone
# shares the same query-first workflow; each dev rebuilds their own graphify-out/.
graphify-out/

# ---- Claude Code workspace ----
# Only the graphify skill + shared settings are tracked; the rest of
# .claude/skills/ is whatever each developer installed globally, so it stays
# untracked (it also carries large font/binary assets).
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
!.claude/skills/
.claude/skills/*
!.claude/skills/graphify/

# Pasted console/operational output. These files have leaked a production
# secret inventory (names + digests) and full stack traces before — see
# L-1 in docs/plans/SECURITY-MEMORY-AUDIT-PLAN.md. Attach real assets
# (images, fixtures) explicitly instead of pasting terminal transcripts.
attached_assets/Pasted--*flyctl*secrets*
attached_assets/Pasted--*secrets-list*
